{
    "name": "martin-lechene/itsme-laravel",
    "description": "Laravel package for Itsme authentication using OpenID Connect",
    "type": "library",
    "keywords": [
        "laravel",
        "itsme",
        "authentication",
        "openid-connect",
        "oauth2",
        "belgium",
        "eid",
        "identity"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Lech\u00eaane",
            "email": "martin.lechene@example.com"
        }
    ],
    "homepage": "https://github.com/martin-lechene/itsme-laravel",
    "support": {
        "issues": "https://github.com/martin-lechene/itsme-laravel/issues",
        "source": "https://github.com/martin-lechene/itsme-laravel"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5.22",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ItsmeLaravel\\Itsme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItsmeLaravel\\Itsme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ItsmeLaravel\\Itsme\\ItsmeServiceProvider"
            ],
            "aliases": {
                "Itsme": "ItsmeLaravel\\Itsme\\Facades\\Itsme"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}