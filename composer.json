{
    "name": "martin-lechene/itsme-laravel",
    "description": "Laravel package for itsme authentication using OpenID Connect (beta, community package)",
    "type": "library",
    "keywords": [
        "laravel",
        "itsme",
        "authentication",
        "openid-connect",
        "oauth2",
        "belgium",
        "eid",
        "identity"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Lechêne",
            "email": "contact@doganddev.eu"
        }
    ],
    "homepage": "https://github.com/martin-lechene/itsme-laravel",
    "support": {
        "issues": "https://github.com/martin-lechene/itsme-laravel/issues",
        "source": "https://github.com/martin-lechene/itsme-laravel",
        "docs": "https://github.com/martin-lechene/itsme-laravel#readme",
        "email": "contact@doganddev.eu",
        "security": "https://github.com/martin-lechene/itsme-laravel/security/policy"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpseclib/phpseclib": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5.56|^12.5.22"
    },
    "autoload": {
        "psr-4": {
            "ItsmeLaravel\\Itsme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItsmeLaravel\\Itsme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ItsmeLaravel\\Itsme\\ItsmeServiceProvider"
            ],
            "aliases": {
                "Itsme": "ItsmeLaravel\\Itsme\\Facades\\Itsme"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
